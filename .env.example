# TrainOS local development defaults to SQLite.
# No Docker or PostgreSQL service is required for Phase 1 and early MVP work.
DATABASE_ENGINE=sqlite
USE_POSTGRES=False
# SQLite database file path is configured by Django as: backend/db.sqlite3

DJANGO_SECRET_KEY=change-me-in-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Taipei
FRONTEND_ORIGIN=http://localhost:5173

# Optional future PostgreSQL setup.
# Use this later for heavier Strava imports, analytics, deployment, or production-readiness.
# To enable it, set DATABASE_ENGINE=postgres or USE_POSTGRES=True, then provide either DATABASE_URL or the individual POSTGRES_* variables.
# DATABASE_URL=postgres://trainos:trainos_dev_password@localhost:5432/trainos
POSTGRES_DB=trainos
POSTGRES_USER=trainos
POSTGRES_PASSWORD=trainos_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
